{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "custom-worker.ts",
  "name": "soyartemio-web",
  "routes": [
    {
      "pattern": "soyartemio.me",
      "custom_domain": true
    },
    {
      "pattern": "www.soyartemio.me",
      "custom_domain": true
    }
  ],
  "compatibility_date": "2025-09-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "soyartemio-web"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "WHATSAPP_ALERTS_DB",
      "database_name": "soyartemio-s1gnal",
      "database_id": "61d93e70-57ce-4da1-8111-a8e2115834ae",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "0 0 * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
